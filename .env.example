# Zero-hallucination mode (strict — extractive answers only, no external LLM)
STRICT_ZERO_HALLUCINATION=true
REQUIRE_3GPP_SPEC_EVIDENCE=true
REJECT_ON_INVALID_CITATION=true
REJECT_ON_UNGROUNDED_CLAIM=true
MIN_CON_CONFIDENCE=0.75
MIN_GROUNDING_SCORE=0.45
MIN_SPEC_CHUNKS=1

# 3GPP primary source
INDEX_KG_SUPPLEMENT=true
SPEC_SOURCE_BOOST=3.0
DEMO_MODE=false
HF_DATASET=GSMA/telecom-kg-rel19
